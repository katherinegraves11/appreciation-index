# Required — from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional — a shared passcode for pilot users. Leave blank to open the app to anyone with the link.
ACCESS_CODE=

# Optional — Supabase project (free tier is fine). Without these, briefs are held in memory only
# and will disappear between deployments / serverless invocations.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Optional — override the model (defaults to claude-opus-5)
BAGINDEX_MODEL=claude-opus-5
